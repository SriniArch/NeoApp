[Unit]
Description=NeoApp2 FastAPI Service
After=network.target

[Service]
Type=simple
User=neoapp
Group=neoapp
WorkingDirectory=/opt/neoapp2/current
EnvironmentFile=/etc/neoapp2/neoapp.env
ExecStart=/opt/neoapp2/venv/bin/python -m uvicorn web.backend.main:app --host 127.0.0.1 --port 8000 --ws wsproto
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
